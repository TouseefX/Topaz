<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.exec.topaz">

    <!-- Permissions are injected from Cargo.toml metadata -->

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- Main Activity (NativeActivity) -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <meta-data
                android:name="android.app.lib_name"
                android:value="topaz_gui" />
            <meta-data
                android:name="android.requestLegacyExternalStorage"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Foreground Service for background server -->
        <service
            android:name="com.exec.topaz.TopazForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>