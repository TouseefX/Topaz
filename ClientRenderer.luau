		GiftIcon:deselect()
	end
end)
GiftIcon:bindEvent("deselected", function()

	PlayerList.Visible = false
	GiftList.Visible = false
	SoundUtil.PlaySound("UIButtonClick")
end)
GiftIcon:bindEvent("selected", function()

	PlayerList.Visible = true
	GiftList.Visible = true
	SoundUtil.PlaySound("UIButtonClick")
end)

local FreeGoldIcon = lib.new():setTip("Get Free Gold"):setImage(103344393618418):setName("FreeGoldIcon"):setOrder(9):bindEvent("selected", function()

	SoundUtil.PlaySound("UIButtonClick")
end):bindEvent("deselected", function()

	SoundUtil.PlaySound("UIButtonClick")
end)
local FreeGoldIcons = {}
local Container4 = PlayerGui:WaitForChild("SupportBonus"):WaitForChild("Container")
local SupportBonusIcon = lib.new():setLabel("Support Bonus"):setImage(14906117295):setOrder(9):setName("SupportBonusIcon"):setCornerRadius(0, 0)

GetIconButton("SupportBonusIcon").MouseButton1Click:Connect(function()

	Container4.Visible = not Container4.Visible
	SoundUtil.PlaySound("UIButtonSelect")
end)

local Container5 = PlayerGui:WaitForChild("DailyReward"):WaitForChild("Container")
local DailyRewardIcon = lib.new():setLabel("Daily Reward"):setImage(14928884836):setOrder(10):setName("DailyRewardIcon"):setCornerRadius(0, 0)

GetIconButton("DailyRewardIcon").MouseButton1Click:Connect(function()

	Container5.Visible = not Container5.Visible
	SoundUtil.PlaySound("UIButtonSelect")
end)
LocalPlayer:SetAttribute("LoadingAdsTopbar", true)
task.spawn(function()

	local ok, result = pcall(game:GetService("PolicyService").GetPolicyInfoForPlayerAsync, game:GetService("PolicyService"), LocalPlayer)

	if ok and result then
		if result.AreAdsAllowed then
			local AdsPlayerIcon = lib.new():setLabel("Watch Ads"):setImage(15197813128):setOrder(11):setName("AdsPlayerIcon"):setCornerRadius(0, 0)
			local Container6 = PlayerGui:WaitForChild("AdPlayer"):WaitForChild("Container")

			GetIconButton("AdsPlayerIcon").MouseButton1Click:Connect(function()

				Container6.Visible = not Container6.Visible
				SoundUtil.PlaySound("UIButtonSelect")
			end)
			table.insert(FreeGoldIcons, AdsPlayerIcon)
			LocalPlayer:SetAttribute("LoadingAdsTopbar", nil)

			return
		end

		LocalPlayer:SetAttribute("LoadingAdsTopbar", nil)

		return
	end

	LocalPlayer:SetAttribute("LoadingAdsTopbar", nil)
end)
task.spawn(function()

	if LocalPlayer:GetAttribute("LoadingAdsTopbar") then
		LocalPlayer:GetAttributeChangedSignal("LoadingAdsTopbar"):Wait()
	end

	table.insert(FreeGoldIcons, SupportBonusIcon)
	table.insert(FreeGoldIcons, DailyRewardIcon)
	FreeGoldIcon:setDropdown(FreeGoldIcons)
end)
print("VERSION:", game.PlaceVersion)

if typeof(LocalPlayer:GetAttribute("RankInGroup")) ~= "number" then
	LocalPlayer:GetAttributeChangedSignal("RankInGroup"):Wait()
end

if (LocalPlayer:GetAttribute("RankInGroup") or 0) >= 50 then
	local ContainerFrame7 = PlayerGui:WaitForChild("AdminPanel"):WaitForChild("ContainerFrame")
	local AdminSpacerIcon = lib.new():setLabel(""):setEnabled(false)

	lib.new():setTip("Administrator Panel"):setImage(15114344091):setName("CommandIcon"):setDropdown({ AdminSpacerIcon }):bindEvent("selected", function()

		ContainerFrame7.Visible = true
		SoundUtil.PlaySound("UIButtonClick")
	end):bindEvent("deselected", function()

		ContainerFrame7.Visible = false
		SoundUtil.PlaySound("UIButtonClick")
	end)
end

print("RANK LOADED")


