					end

					local rayDistance = if typeof(groundDistance) == "number" then math.abs(groundDistance) else 20
					local rockSize = Vector3.new(sizeX, sizeY, sizeZ)
					local directions = {
						-1,
						1
					}
					local directionCount = #directions

					for _ = 1, count do
						local childTexture = nil
						local childTransparency = nil
						local raycastResult = workspace:Raycast(cFrame.Position, Vector3.new(0, -rayDistance, 0), raycastParams)

						if raycastResult then
							local rockColor = VFXService.MakeDarker(raycastResult.Instance.Color, 10, 10, 10)
							local rockMaterial = if raycastResult.Instance.Material ~= Enum.Material.Plastic then raycastResult.Instance.Material else Enum.Material.SmoothPlastic
							local rockCFrame = CFrame.new(raycastResult.Position) + Vector3.new(0, sizeY / 2, 0)

							for _, child in pairs(raycastResult.Instance:GetChildren()) do
								if child:IsA("Texture") then
									childTexture = child.Texture
									childTransparency = child.Transparency

									break
								end
							end

							local xVelocity = random:NextNumber(xVelocityRange[1], xVelocityRange[2]) * directions[random:NextInteger(1, directionCount)]
							local yVelocity = random:NextNumber(yVelocityRange[1], yVelocityRange[2])
							local zVelocity = random:NextNumber(zVelocityRange[1], zVelocityRange[2]) * directions[random:NextInteger(1, directionCount)]
							local angularX = angularSpeed * directions[random:NextInteger(1, directionCount)]
							local angularY = angularSpeed * directions[random:NextInteger(1, directionCount)]
							local angularZ = angularSpeed * directions[random:NextInteger(1, directionCount)]

							properties[#properties + 1] = {
								Lifetime = lifetime,
								Color = rockColor,
								Material = rockMaterial,
								Texture = childTexture,
								TextureTransparency = childTransparency,
								CFrame = rockCFrame,
								Size = rockSize,
								AssemblyAngularVelocity = Vector3.new(angularX, angularY, angularZ),
								AssemblyLinearVelocity = Vector3.new(xVelocity, yVelocity, zVelocity)
							}
						end
					end
				end,
				ApplyFlyingRocksProperties = function(properties)

