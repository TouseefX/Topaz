				GetTile = function(vector3: Vector3, distance: number)

					if typeof(vector3) ~= "Vector3" then
						return
					end

					if typeof(distance) ~= "number" then
						distance = 7
					end

					local raycastResult = workspace:Raycast(vector3, Vector3.new(0, -math.abs(distance), 0), tileRaycastParams)

					if raycastResult and raycastResult.Instance and raycastResult.Instance:GetAttribute("Destroyed") ~= true then
						return raycastResult.Instance
					end
