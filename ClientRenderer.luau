							if typeof(offsetZRange) == "table" then
								offsetZ = random:NextNumber(offsetZRange[1], offsetZRange[2])
							end

							local rockSize = Vector3.new(rockSizeX, rockSizeY, rockSizeZ)

							Color3.fromRGB(120, 120, 120)

							local _ = Enum.Material.Concrete
							local randomRotation = nil
							local childTexture = nil
							local childTransparency = nil
							local sortedSizes = {
								rockSizeX,
								rockSizeY,
								rockSizeZ
							}

							table.sort(sortedSizes)

							local largestSize = sortedSizes[3]
							local rockCFrame = groundCFrame * CFrame.Angles(0, math.rad(angle), 0) * CFrame.new(0, 0, rockRadius)
							local Position = rockCFrame.Position
							local raycastResult3 = workspace:Raycast(Position + Vector3.new(0, 5, 0), Vector3.new(0, -largestSize * 2.5, 0), raycastParams)

							if not raycastResult3 then
								continue
							end

							local rockColor = VFXService.MakeDarker(raycastResult3.Instance.Color, 10, 10, 10)
							local rockMaterial = if raycastResult3.Instance.Material ~= Enum.Material.Plastic then raycastResult3.Instance.Material else Enum.Material.SmoothPlastic

							if raycastResult3.Normal.Y ~= 1 then
								rockCFrame = CFrame.new(raycastResult3.Position, raycastResult3.Position + raycastResult3.Normal)
							end

							local raycastResult3Position = raycastResult3.Position

							for _, child in pairs(raycastResult3.Instance:GetChildren()) do
								if child:IsA("Texture") then
									childTexture = child.Texture
									childTransparency = child.Transparency

									break
								end
							end

							if randomOrientation == true then
								randomRotation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
							else
								local facingHeight = if typeof(heightVector) ~= "Vector3" then if typeof(heightMultiplier) ~= "number" then Vector3.new(0, rockRadius, 0) else Vector3.new(0, rockRadius * heightMultiplier or 1, 0) else heightVector

								rockCFrame = CFrame.new(raycastResult3.Position, groundCFrame.Position + facingHeight)

								local slantLength = math.sqrt(math.pow(facingHeight.Y, 2) + math.pow(rockRadius, 2))
								local rockThickness = rockSizeY * 0.5 / math.cos((math.asin(facingHeight.Y / slantLength))) * 2

								if offsetX ~= 0 or offsetY ~= 0 or offsetZ ~= 0 then
									local cFrame3Position = groundCFrame.Position
									local flattenedPosition = Vector3.new(raycastResult3Position.X, cFrame3Position.Y, raycastResult3Position.Z)
									local lateralCFrame = CFrame.new(cFrame3Position, flattenedPosition)
									local offsetPosition = raycastResult3Position + (lateralCFrame.LookVector * offsetZ + lateralCFrame.RightVector * offsetX)
									local raycastResult4 = workspace:Raycast(offsetPosition + Vector3.new(0, 5, 0), Vector3.new(0, -largestSize * 2.5, 0), raycastParams)

									if not raycastResult4 then
										continue
									end

									rockColor = VFXService.MakeDarker(raycastResult4.Instance.Color, 10, 10, 10)
									rockMaterial = if raycastResult4.Instance.Material ~= Enum.Material.Plastic then raycastResult4.Instance.Material else Enum.Material.SmoothPlastic
									raycastResult3Position = raycastResult4.Position

									for _, child in pairs(raycastResult4.Instance:GetChildren()) do
										if child:IsA("Texture") then
											childTexture = child.Texture
											childTransparency = child.Transparency

											break
										end
									end
								end

								raycastResult3Position -= Vector3.new(0, rockThickness / 8 + offsetY, 0)
							end

							properties[#properties + 1] = {
								Lifetime = lifetime,
								AnimationStyle = animationStyle,
								Size = rockSize,
								Color = rockColor,
								Material = rockMaterial,
								Orientation = randomRotation,
								CFrame = rockCFrame,
								Position = raycastResult3Position,
								Texture = childTexture,
								TextureTransparency = childTransparency
							}

							if duplicateSettings.IncludeDuplicate == true then
								properties[#properties + 1] = {
									Lifetime = lifetime,
									AnimationStyle = animationStyle,
									Size = rockSize / (duplicateSettings.ShrinkFactor or 1.15),
									Color = rockColor,
									Material = rockMaterial,
									Orientation = randomRotation,
									CFrame = rockCFrame,
									Position = raycastResult3Position + rockCFrame.LookVector * (duplicateSettings.RadiusOffset or rockSize.Z / 4) + rockCFrame.UpVector * (duplicateSettings.RadiusOffsetY or -rockSize.Y / 4) + Vector3.new(0, duplicateSettings.LinearOffsetY or 0, 0),
									Texture = childTexture,
									TextureTransparency = childTransparency
								}
							end

							angle += angleStep
						end

						return
					end
				end,
				ApplyCircularRocksProperties = function(properties)

					if #properties <= 0 then
						return
					end

					local Folder2 = Instance.new("Folder")

					Folder2.Name = "CircularRocks"
					Folder2.Parent = VFX

					for k, v in pairs(properties) do
						local rockParts = {}
						local AnimationStyle = v.AnimationStyle
						local vLifetime = v.Lifetime
						local Part = Instance.new("Part")

						table.insert(rockParts, Part)
						Part.Name = "Rock" .. k
						Part.Anchored = true
						Part.CollisionGroup = "Circular Rocks"
						Part.EnableFluidForces = false
						Part.Massless = true
						Part.CanQuery = false
						Part.CanTouch = false

						for k2, v2 in pairs(v) do
							if v2 ~= nil then
								if k2 ~= "Texture" and k2 ~= "Lifetime" and k2 ~= "AnimationStyle" and k2 ~= "TextureTransparency" then
									Part[k2] = v2
								elseif k2 == "Texture" then
									for i = 1, 6 do
										local Texture = Instance.new("Texture")

										Texture.Texture = v2

										if i == 1 then
											Texture.Face = "Front"
										elseif i == 2 then
											Texture.Face = "Left"
										elseif i == 3 then
											Texture.Face = "Right"
										elseif i == 4 then
											Texture.Face = "Back"
										elseif i == 5 then
											Texture.Face = "Top"
										elseif i == 6 then
											Texture.Face = "Bottom"
										end

										Texture.Transparency = v.TextureTransparency
										Texture.Parent = Part
									end
								end
							end
						end

						if typeof(AnimationStyle) == "table" then
							local animationIn = AnimationStyle[1] or "Rise"
							local animationOut = AnimationStyle[2] or "Sink"
							local inDuration = AnimationStyle[3] or 0.35
							local outDuration = AnimationStyle[4] or 1.75

							if animationIn == "Rise" then
								local tweenInfo = TweenInfo.new(inDuration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

								for _, v3 in pairs(rockParts) do
									local sizeComponents = {
										v3.Size.X,
										v3.Size.Y,
										v3.Size.Z
									}
									local maxSize = 0

									for _, v4 in ipairs(sizeComponents) do
										if maxSize < v4 then
											maxSize = v4
										end
									end

									local v3Orientation = v3.Orientation

									v3.Orientation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
									v3.Position = v3.Position - Vector3.new(0, maxSize + 1, 0)
									v3.Parent = Folder2
									TweenService:Create(v3, tweenInfo, {
										Orientation = v3Orientation,
										Position = v3.Position + Vector3.new(0, maxSize + 1, 0)
									}):Play()
								end
							end

							if animationIn == "Grow" then
								local tweenInfo = TweenInfo.new(inDuration, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

								for _, v5 in pairs(rockParts) do
									local v5Size = v5.Size

									v5.Size = Vector3.new(0, 0, 0)
									v5.Parent = Folder2
									TweenService:Create(v5, tweenInfo, {
										Size = v5Size
									}):Play()
								end
							end

							task.delay(vLifetime or 5, function()

								if animationOut == "Sink" then
									local tweenInfo = TweenInfo.new(outDuration, Enum.EasingStyle.Circular, Enum.EasingDirection.In)

									for _, v6 in pairs(rockParts) do
										local OrientationX = v6.Orientation.X
										local OrientationY = v6.Orientation.Y
										local _ = v6.Orientation.Z
										local _ = OrientationX + math.random(-20, 20)
										local _ = OrientationY + math.random(-20, 20)
										local _ = OrientationY + math.random(-20, 20)

										TweenService:Create(v6, tweenInfo, {
											Position = v6.Position - Vector3.new(0, v6.Size.Y + 10, 0)
										}):Play()
									end

									task.wait(outDuration)
									Folder2:Destroy()
								end

								if animationOut == "Shrink" then
									local tweenInfo = TweenInfo.new(outDuration, Enum.EasingStyle.Circular, Enum.EasingDirection.Out)

									for _, v7 in pairs(rockParts) do
										TweenService:Create(v7, tweenInfo, {
											Size = Vector3.new(0, 0, 0)
										}):Play()
									end

									task.wait(outDuration)
									Folder2:Destroy()
								end
							end)
						end
					end

					return Folder2
				end,
				GetFlyingRocksProperties = function(properties: string, cFrame: CFrame, count: number, xVelocityRange: number, yVelocityRange: number, zVelocityRange: number, sizeX: number, sizeY: number, sizeZ: number, angularSpeed: number, lifetime: number, groundDistance: number)

					if typeof(cFrame) ~= "CFrame" then
						return
