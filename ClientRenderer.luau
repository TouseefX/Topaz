				EmitParticlesInInstance = function(instance)

					if typeof(instance) ~= "Instance" then
						return
					end

					for _, descendant in ipairs(instance:GetDescendants()) do
						if descendant:IsA("ParticleEmitter") then
							local EmitDelay = descendant:GetAttribute("EmitDelay")

							if typeof(EmitDelay) ~= "number" or EmitDelay <= 0 then
								local count = descendant:GetAttribute("EmitCount") or (tonumber(descendant.Name) or 1)

								if not LocalSettings.FastMode then
									descendant:Emit(count)
								else
									descendant:Emit((math.ceil(count / 2)))
								end

								local num = tonumber(descendant:GetAttribute("EmitDuration"))

								if typeof(num) == "number" and num > 0 then
									descendant.Enabled = true
									task.delay(num, function()

										if descendant ~= nil and descendant.Parent ~= nil then
											descendant.Enabled = false
										end
									end)
								end
							else
								task.delay(EmitDelay, function()

									if descendant ~= nil and descendant.Parent ~= nil then
										local count = descendant:GetAttribute("EmitCount") or (tonumber(descendant.Name) or 1)

										if not LocalSettings.FastMode then
											descendant:Emit(count)
										else
											descendant:Emit((math.ceil(count / 2)))
										end

										local num = tonumber(descendant:GetAttribute("EmitDuration"))

										if typeof(num) == "number" and num > 0 then
											descendant.Enabled = true
											task.delay(num, function()

												if descendant ~= nil and descendant.Parent ~= nil then
													descendant.Enabled = false
												end
											end)
										end
									end
								end)
							end
						elseif descendant:IsA("Beam") then
							local EmitDuration = descendant:GetAttribute("EmitDuration")

							if typeof(EmitDuration) == "number" and not (EmitDuration <= 0) then
								local EmitDelay = descendant:GetAttribute("EmitDelay")

								if typeof(EmitDelay) == "number" and EmitDelay > 0 then
									task.delay(EmitDelay, function()

										if descendant ~= nil and descendant.Parent ~= nil then
											descendant.Enabled = true
											task.delay(EmitDuration, function()

												if descendant ~= nil and descendant.Parent ~= nil then
													descendant.Enabled = false
												end
											end)
										end
									end)
								else
									descendant.Enabled = true
									task.delay(EmitDuration, function()

										if descendant ~= nil and descendant.Parent ~= nil then
											descendant.Enabled = false
										end
									end)
								end
							end
						end
					end
				end,
				FindGroundPosition = function(position: Vector3, distance: number, raycastFilter)

					if typeof(position) ~= "Vector3" then
						return
					end

					if typeof(distance) ~= "number" then
						distance = 7.5
					end

					if typeof(raycastFilter) ~= "RaycastParams" then
						raycastFilter = raycastParams
					end

					if distance < 0 then
						distance = math.abs(distance)
					end

					return (workspace:Raycast(position, Vector3.new(0, -distance, 0), raycastFilter))
				end,
