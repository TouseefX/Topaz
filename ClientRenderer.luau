-- =============== Settings sync handler (applies live setting changes from other scripts) ===============
ClientCommunication.Event:Connect(function(Data)

	local Request = Data.Request

	if Request == "GlobalMessage" then
		local p512Title = Data.Title
		local p512Message = Data.Message
		local TitleColor = Data.TitleColor
		local p512Lifetime = Data.Lifetime

		task.spawn(UIService.GlobalMessage, p512Title, p512Message, TitleColor, p512Lifetime)
	end

	if Request == "NewLocalSettings" then
		local New = Data.New

		if New.AutoSkill == false then
			AutoSkillIcon:setImage(15830811206)
		end

		if New.Blood == false then
			BloodIcon:setImage(15830811206)
		end

		if New.FastMode == true then
			FastModeIcon:setImage(15830811898)
		end

		if New.PhotosensitiveMode == true then
			PhotosensitiveModeIcon:setImage(15830811898)
		end

		if New.HideAccessories == true then
			HideAccessoriesIcon:setImage(15830811898)
			AccessoryMask:Enable()
		end

		if New.HidePackages == true then
			HidePackagesIcon:setImage(15830811898)
			PackageMask:Enable()
		end

		if New.HideLeaderboards == true then
			HideLeaderboardsIcon:setImage(15830811898)
			LeaderboardsMask:Enable()
		end

		if New.MuteAwakeningMusic == true then
			MuteAwakeningMusicIcon:setImage(15830811898)

			if LocalSettings.MuteAwakeningMusic == true then
				for _, v in pairs(CollectionService:GetTagged("AwakeningTheme")) do
					if v:IsA("Sound") then
						v.Volume = 0
					end
				end
			end
		end

		if New.DestructionPhysics == false then
			DestructionPhysicsIcon:setImage(15830811206)
		end

		if New.HideKM == false then
			HideKillMessagesIcon:setImage(15830811206)
			LocalPlayer:SetAttribute("HideKillMessagesSetting", nil)
		end

		if New.HideKills == true then
			HideKillsIcon:setImage(15830811898)
		end

		if New.HideKillstreak == true then
			HideKillstreakIcon:setImage(15830811898)
		end

		if New.KillSound == false then
			KillSoundIcon:setImage(15830811206)
		end

		if typeof(New.CameraShakeMultiplier) == "number" and New.CameraShakeMultiplier ~= 1 then
			CameraShakeMultiplierIcon:setLabel("Camera Shake Multiplier: " .. tostring(LocalSettings.CameraShakeMultiplier) .. "x")
		end

		if typeof(New.VolumeMultiplier) == "number" and New.VolumeMultiplier ~= 1 then
			VolumeIcon:setLabel("Volume: " .. tostring(LocalSettings.VolumeMultiplier) .. "x")

			for _, v in pairs(CollectionService:GetTagged("NormalSFX")) do
				if v:IsA("Sound") and typeof(v:GetAttribute("DefaultVolume")) == "number" and not v:HasTag("AwakeningTheme") then
					v.Volume = v:GetAttribute("DefaultVolume") * LocalSettings.VolumeMultiplier
				end
			end

			if LocalSettings.MuteAwakeningMusic == true then
				for _, v in pairs(CollectionService:GetTagged("AwakeningTheme")) do
					if v ~= nil and v.Parent ~= nil then
						v.Volume = 0
					end
				end
			elseif CutsceneMutingMusic ~= true then
				for _, v in pairs(CollectionService:GetTagged("AwakeningTheme")) do
					if v ~= nil and v.Parent ~= nil then
						v.Volume = (v:GetAttribute("DefaultVolume") or 0.5) * LocalSettings.VolumeMultiplier
					end
				end
			end
		end

		if typeof(New.EmoteVolumeMultiplier) == "number" and New.EmoteVolumeMultiplier ~= 1 then
			EmoteVolumeIcon:setLabel("Emote Volume: " .. tostring(LocalSettings.EmoteVolumeMultiplier) .. "x")

			for _, v in pairs(CollectionService:GetTagged("EmoteSFX")) do
				if v:IsA("Sound") and typeof(v:GetAttribute("EmoteDefaultVolume")) == "number" then
					v.Volume = v:GetAttribute("EmoteDefaultVolume") * LocalSettings.EmoteVolumeMultiplier
				end
			end
		end

		if typeof(New.ShiftlockOffset) == "number" and New.ShiftlockOffset ~= 1.75 then
			LocalPlayer:SetAttribute("ShiftlockOffset", LocalSettings.ShiftlockOffset)
			ShiftlockOffsetIcon:setLabel("Shiftlock Offset:" .. tostring(LocalSettings.ShiftlockOffset) .. " Studs")
		end

		if typeof(New.ConsoleSettings.Sensitivity) == "number" and ConsoleSensitivityIcon ~= nil then
			ConsoleSensitivityIcon:setLabel("Console Camera Sensitivity: " .. tostring(LocalSettings.ConsoleSettings.Sensitivity))
			GamepadCamera:SetSensitivityFactor(LocalSettings.ConsoleSettings.Sensitivity)
		end

		if typeof(New.ConsoleSettings.ShowControls) == true and ShowConsoleControlsIcon ~= nil then
			ShowConsoleControlsIcon:setImage(15830811898)

			if UserInputService.GamepadEnabled == true then
				ConsoleControls.Visible = true
			else
				ConsoleControls.Visible = false
			end
		end
	end

	if Request == "PlaySound" then
		SoundUtil.PlaySound(Data.SoundName)
	end
end)
