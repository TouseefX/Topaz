							lookY = 0.001
						end

						local groundCFrame = CFrame.new(raycastResult.Position, raycastResult.Position + Vector3.new(LookVectorX, lookY, LookVectorZ))

						for _ = 1, count do
							local rockRadius = radius
							local rockSizeX = sizeX
							local rockSizeY = sizeY
