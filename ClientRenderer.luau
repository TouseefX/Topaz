				end,
				EmitFromCFrame = function(cFrame: CFrame, emitters: string, lifetime: number, useAttachment: boolean, emitCounts: string, color3: Color3)

					if typeof(cFrame) ~= "CFrame" then
						return
					end

					if typeof(emitters) ~= "table" then
						return
					end

					if typeof(lifetime) ~= "number" then
						lifetime = 3
					end

					if typeof(useAttachment) ~= "boolean" then
						useAttachment = true
					end

					if typeof(emitCounts) ~= "table" then
						emitCounts = {}

						if not LocalSettings.FastMode then
							for _, v in pairs(emitters) do
								local EmitCount = v:GetAttribute("EmitCount")

								if typeof(EmitCount) ~= "number" then
									local num = tonumber(v.Name)

									if typeof(num) == "number" then
										table.insert(emitCounts, num)

										continue
									end

									return
								end

								table.insert(emitCounts, EmitCount)
							end
						else
							for _, v in pairs(emitters) do
								local EmitCount = v:GetAttribute("EmitCount")

								if typeof(EmitCount) ~= "number" then
									local num = tonumber(v.Name)

									if typeof(num) == "number" then
										table.insert(emitCounts, (math.ceil(num / 2)))

										continue
									end

									return
								end

								table.insert(emitCounts, (math.ceil(EmitCount / 2)))
							end
						end
					end

					local Part = Instance.new("Part")

					Part.CFrame = cFrame
					Part.Size = Vector3.new(0, 0, 0)
					Part.Material = Enum.Material.SmoothPlastic
					Part.Massless = true
					Part.EnableFluidForces = false
					Part.CanCollide = false
					Part.Anchored = true
					Part.CanQuery = false
					Part.CanTouch = false
					Part.CastShadow = false
					Part.Transparency = 1
					Part.Parent = VFX

					local clones = {}

					for _, v in pairs(emitters) do
						local clone = v:Clone()

						if typeof(color3) == "Color3" then
							clone.Color = ColorSequence.new(color3)
						end

						table.insert(clones, clone)
					end

					if useAttachment == true then
						local Attachment = Instance.new("Attachment")

						Attachment.Parent = Part

						for _, v in pairs(clones) do
							v.Parent = Attachment
						end
					else
						for _, v in pairs(clones) do
							v.Parent = Part
						end
					end

					for k, _ in pairs(emitters) do
						local count = emitCounts[k]

						clones[k]:Emit(count)
					end

					Debris.AddItem(Part, lifetime)

					return Part
				end,
