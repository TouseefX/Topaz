					if typeof(unusedOffsetZ) ~= "number" and typeof(unusedOffsetZ) ~= "table" then
						return
					end

					if typeof(animationStyle) ~= "table" then
						return
					end

					if typeof(lifetime) ~= "number" then
						lifetime = 5
					end

					if typeof(randomOrientation) ~= "boolean" then
						randomOrientation = false
					end

					if typeof(duplicateSettings) ~= "table" then
						duplicateSettings = {
