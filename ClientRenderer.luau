					local positionInfluence = Vector3.new(positionX, positionY, positionZ)

					if CameraShaker._running == false then
						CameraShaker:Start()
					end

					CameraShaker:ShakeOnce(intensity, intensity, fadeInTime, fadeOutTime, positionInfluence, (Vector3.new(0, 0, 0)))
