		local HiddenKills = {}

		local function HideKillsOf(player)

			local leaderstats = player:FindFirstChild("leaderstats")

			if leaderstats ~= nil and leaderstats.Parent ~= nil then
				local totalKills = leaderstats:FindFirstChild("Total Kills")
				local monthlyKills = leaderstats:FindFirstChild("Monthly Kills")

				HiddenKills[player] = {}

				if totalKills ~= nil and totalKills.Parent ~= nil then
					totalKills.Parent = nil
					HiddenKills[player].T = totalKills
				end

				if monthlyKills ~= nil and monthlyKills.Parent ~= nil then
					monthlyKills.Parent = nil
					HiddenKills[player].M = monthlyKills
				end
			end
		end
		local function RevealKillsOf(player)

			local leaderstats = player:FindFirstChild("leaderstats")

			if leaderstats ~= nil and (leaderstats.Parent ~= nil and typeof(HiddenKills[player]) == "table") then
				if typeof(HiddenKills[player].T) == "Instance" then
					HiddenKills[player].T.Parent = leaderstats
				end

				if typeof(HiddenKills[player].M) == "Instance" then
					HiddenKills[player].M.Parent = leaderstats
				end
			end

			HiddenKills[player] = nil
		end
		local function DumpMaskMemoryOnCharacterRemoved(character)

			if typeof(PackageMask.Hidden[character]) == "table" then
				for _, v in pairs(PackageMask.Hidden[character]) do
					pcall(function()

						v:Destroy()
					end)
				end

				PackageMask.Hidden[character] = nil
			end

			if typeof(AccessoryMask.Hidden[character]) == "table" then
				for _, v in pairs(AccessoryMask.Hidden[character]) do
					pcall(function()

						v:Destroy()
					end)
				end

				AccessoryMask.Hidden[character] = nil
			end
		end

		for _, player in pairs(Players:GetPlayers()) do
			player.CharacterRemoving:Connect(DumpMaskMemoryOnCharacterRemoved)
