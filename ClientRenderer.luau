				ShakeCamera = function(fadeInTime: number, fadeOutTime: number, intensity: number, positionX: number, positionY: number, positionZ: number, ignoreSuppression: boolean, ignoreMultiplier: boolean)

					local CameraShakeMultiplier = LocalSettings.CameraShakeMultiplier

					if CameraShakeMultiplier <= 0 and ignoreMultiplier ~= true then
						return
					end

					if SuppressCameraShake == true and ignoreSuppression ~= true then
						return
					end

					if typeof(fadeInTime) ~= "number" then
						fadeInTime = 0
					end

					if typeof(fadeOutTime) ~= "number" then
						fadeOutTime = 0.4
					end

					if typeof(intensity) ~= "number" then
						intensity = 15
					end

					if typeof(positionX) ~= "number" then
						positionX = 0.25
					end

					if typeof(positionY) ~= "number" then
						positionY = 0.5
					end

					if typeof(positionZ) ~= "number" then
						positionZ = 0.25
					end

					if ignoreMultiplier ~= true then
