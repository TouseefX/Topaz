				GetRandomAngle = function(minAngle: number, maxAngle: number)

					if typeof(minAngle) ~= "number" then
						minAngle = 0
					end

					if typeof(maxAngle) ~= "number" then
						maxAngle = 6.283185307179586
					end

					if maxAngle <= minAngle then
						return
					end

					return random:NextNumber(minAngle, maxAngle)
				end,
