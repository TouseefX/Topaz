	local Container = workspace:WaitForChild("Leaderboards"):WaitForChild("Donate"):WaitForChild("Screen"):WaitForChild("UI"):WaitForChild("Container"):WaitForChild("List"):WaitForChild("Container")
	local tweenInfo = TweenInfo.new(0.162, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local tweenInfo175 = TweenInfo.new(0.85, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
	local Donate = Remotes:WaitForChild("Donate")

	local function DonationFlashEffect(p511)

		local Frame = Instance.new("Frame")
		local tween = TweenService:Create(Frame, tweenInfo175, {
			BackgroundTransparency = 1
		})

		tween.Completed:Connect(function()

			if Frame ~= nil and Frame.Parent ~= nil then
				Frame:Destroy()
			end
		end)
		Frame.Name = "FlashEffect"
		Frame.BorderSizePixel = 0
		Frame.Size = UDim2.new(1, 0, 1, 0)
		Frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

		local UICorner = Instance.new("UICorner")

		UICorner.CornerRadius = UDim.new(1, 0)
		UICorner.Parent = Frame
		Frame.Parent = p511
		tween:Play()
	end

	for _, descendant in pairs(Container:GetDescendants()) do
		if descendant:IsA("TextButton") then
			local tween = nil

			descendant.MouseEnter:Connect(function()

				tween = TweenService:Create(descendant.Parent.Background, tweenInfo, {
					BackgroundTransparency = 0.4
				})
				tween:Play()
			end)
			descendant.MouseLeave:Connect(function()

				if tween ~= nil then
					tween:Cancel()
				end

				TweenService:Create(descendant.Parent.Background, tweenInfo, {
					BackgroundTransparency = 0.8
				}):Play()
			end)

			local ParentName = descendant.Parent.Name

			descendant.MouseButton1Click:Connect(function()

				DonationFlashEffect(descendant.Parent)
				SoundUtil.PlaySound("UIButtonClick")
				Donate:FireServer({
					Request = tostring(ParentName)
				})
			end)
		end
	end

